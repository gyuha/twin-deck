  "app": {
    "windows": [{ "title": "Twin Deck", "width": 1200, "height": 760, "acceptFirstMouse": true, "visible": false }],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["**"] } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzQUNDREJCRUM4OTM2MzIKUldReU5vbnN1ODJzd3hwSnpTcWUvdFFNVDVneUlQd1R3SkRaYy9Ndm9CRXlKdHN4WGdIQjJ2WjkK",
      "endpoints": ["https://github.com/gyuha/twin-deck/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
